{
  "manifest_version": 3,
  "name": "Job Filter v2",
  "version": "2.2.0",
  "description": "Personal job filter: rules + local AI backend. Load unpacked only; never publish.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "notifications", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.glassdoor.com/*",
    "https://www.glassdoor.co.in/*",
    "https://www.naukri.com/*",
    "https://in.indeed.com/*",
    "https://www.indeed.com/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Filter v2",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["common/filters.js", "sites/linkedin.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.glassdoor.com/*", "https://www.glassdoor.co.in/*"],
      "js": ["common/filters.js", "sites/scraper-core.js", "sites/glassdoor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.naukri.com/*"],
      "exclude_matches": ["https://www.naukri.com/job-listings-*"],
      "js": ["common/filters.js", "sites/scraper-core.js", "sites/naukri.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.naukri.com/job-listings-*"],
      "js": ["sites/naukri-job.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://in.indeed.com/*", "https://www.indeed.com/*"],
      "js": ["common/filters.js", "sites/scraper-core.js", "sites/indeed.js"],
      "run_at": "document_idle"
    }
  ]
}
