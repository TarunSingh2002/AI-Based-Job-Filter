{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app:app", "--port", "8765"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false },
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
